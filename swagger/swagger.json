        "responses": {
          "200": {
            "description": "Logout successful",
            "schema": {
              "$ref": "#/definitions/AppResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/AppResponse"
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "description": "Get new access token using refresh token",
        "tags": [
          "auth"
        ],
        "consumes": [
          "application/json"
        ],
        "produces": [
